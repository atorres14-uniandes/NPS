# Configure estos valores en el archivo privado (fuera del webroot):
# C:\laragon\etc\Encuesta NPS\.env
# o en la ruta indicada por la variable de entorno SURVEY_ENV_FILE.
# No pongas secretos en este archivo de ejemplo ni lo llenes con credenciales reales.

# Sandbox: https://test.salesforce.com o el My Domain de la sandbox. Producción: https://login.salesforce.com o el My Domain.
SF_TOKEN_URL="https://test.salesforce.com/services/oauth2/token"

# "password" (usuario de integración) o "client_credentials" (Connected App con usuario "Run As")
SF_GRANT_TYPE="password"
SF_CLIENT_ID="REPLACE_WITH_CONNECTED_APP_CLIENT_ID"
SF_CLIENT_SECRET="REPLACE_WITH_CONNECTED_APP_CLIENT_SECRET"

# Solo para SF_GRANT_TYPE="password". SF_PASSWORD incluye el token de seguridad al final si Salesforce lo requiere.
SF_USERNAME="REPLACE_WITH_INTEGRATION_USERNAME"
SF_PASSWORD="REPLACE_WITH_PASSWORD_AND_SECURITY_TOKEN_IF_REQUIRED"

# URL de la instancia (no la de login) + endpoint Apex REST
SF_APEX_URL="https://vde--full.sandbox.my.salesforce.com/services/apexrest/SurveyCaseServiceV2"
SF_CA_BUNDLE="C:\laragon\etc\ssl\cacert.pem"
